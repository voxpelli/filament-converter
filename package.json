{
  "name": "filament-converter",
  "version": "0.1.0",
  "private": true,
  "description": "Convert Bambu Studio filament profiles to PrusaSlicer INI format",
  "homepage": "https://voxpelli.github.io/filament-converter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxpelli/filament-converter.git"
  },
  "type": "module",
  "scripts": {
    "build:0": "run-s clean",
    "build": "run-s build:*",
    "check:installed-check": "installed-check --engine-check",
    "check:knip": "knip",
    "check:lint": "eslint",
    "check:tsc": "tsc && tsc -p test/tsconfig.json",
    "check:type-coverage": "type-coverage --detail --strict --at-least 99 --ignore-files 'test/**/*'",
    "check": "run-s clean && run-p check:*",
    "clean:declarations-top": "rm -rf $(find . -maxdepth 1 -type f -name '*.d.ts*' ! -name 'index.d.ts')",
    "clean": "run-p clean:*",
    "dev:serve": "browser-sync start --server . --files '*.html,*.css,*.js' --port ${PORT:-3333}",
    "dev": "run-p dev:*",
    "e2e-serve": "npm run dev:serve -- --no-open --no-ui",
    "e2e": "playwright test",
    "fix": "eslint --fix",
    "husky-disable": "git config --unset core.hooksPath",
    "husky-enable": "husky",
    "test:unit": "c8 --reporter=html --reporter=cobertura --reporter=text node --test \"test/unit/**/*.spec.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit-report.xml",
    "test-ci": "run-s test:unit",
    "test-watch": "npm run test:unit -- --watch --test-only",
    "test": "run-s check test:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.15",
    "@voxpelli/eslint-config": "^23.0.0",
    "@voxpelli/tsconfig": "^16.1.0",
    "browser-sync": "^3.0.4",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "installed-check": "^10.0.1",
    "knip": "^5.86.0",
    "npm-run-all2": "^8.0.4",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3"
  }
}
